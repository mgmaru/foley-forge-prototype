{
    "permissions": {
        "allow": [
            "Bash(git status:*)",
            "Bash(git log:*)",
            "Bash(git diff:*)",
            "Bash(git show:*)",
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git stash:*)",
            "Bash(git branch:*)",
            "Bash(git switch:*)",
            "Bash(gh issue list:*)",
            "Bash(gh issue view:*)",
            "Bash(gh issue status:*)",
            "Bash(gh pr list:*)",
            "Bash(gh pr view:*)",
            "Bash(gh label list:*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git rebase:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean -f:*)",
            "Bash(git checkout --:*)",
            "Bash(git restore:*)",
            "Bash(gh issue create:*)",
            "Bash(gh issue comment:*)",
            "Bash(gh issue edit:*)",
            "Bash(gh issue close:*)",
            "Bash(gh issue reopen:*)",
            "Bash(gh issue lock:*)",
            "Bash(gh pr create:*)"
        ],
        "deny": [
            "Bash(gh auth token*)",
            "Bash(env*)",
            "Bash(printenv*)",
            "Bash(echo $GH_TOKEN*)",
            "Bash(echo $GITHUB_TOKEN*)",
            "Read(.env)",
            "Read(.env.*)",
            "Read(~/.config/gh/**)",
            "Bash(gh issue delete:*)",
            "Bash(gh issue transfer:*)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git push origin --delete:*)"
        ]
    },
    "sandbox": {
        "enabled": true,
        "failIfUnavailable": true,
        "network": {
            "allowedDomains": [
                "github.com",
                "api.github.com"
            ]
        },
        "filesystem": {
            "denyRead": [
                "~/.ssh",
                "~/.aws",
                "~/.config/gh"
            ]
        }
    }
}
